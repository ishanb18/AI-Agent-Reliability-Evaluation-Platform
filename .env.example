# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://evaluser:evalpass@localhost:5432/evaldb

# ── LLM Providers (add the keys for the providers you use) ────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# ── App Settings ──────────────────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
